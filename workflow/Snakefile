import os

configfile: "config/config.yaml"

OUTDIR = config.get("outdir", "results")
DATADIR = config.get("data_dir", "data")
INPUT_CSV = config.get("input_csv", "config/input.csv")
RES = config["preprocessing"]["resolution"]
CELLTYPES = config["subsetting"]["celltypes"]
UNCERTAIN_MARGIN = config.get("subsetting", {}).get("uncertain_margin", 0.10)
UNCERTAIN_ABS_MARGIN = config.get("subsetting", {}).get("uncertain_abs_margin", 0.002)

# CellChat dynamic network parsing
CELLCHAT_NETWORKS = config.get("cellchat", {}).get("networks", [["fibroblasts", "macrophages", "mast_cells"]])
NETWORK_MAP = {"_".join(net): ",".join(net) for net in CELLCHAT_NETWORKS}

CELLCHAT_OUTPUTS = [
    os.path.join(OUTDIR, "04_cellchat", folder_name, "multiway_cellchat.rds")
    for folder_name in NETWORK_MAP.keys()
]



rule all:
    input:
        os.path.join(OUTDIR, "01_preprocessing", "TN.combined_dim30.rds"),
        os.path.join(OUTDIR, "02_global_annotation", f"res_{RES}", "TN.combined_annotated.rds"),
        expand(os.path.join(OUTDIR, "03_subsets", "{celltype}", "00_data", "{celltype}_subset_processed.rds"), celltype=CELLTYPES),
        expand(os.path.join(OUTDIR, "03_subsets", "{celltype}", "00_data", "{celltype}_detailed_annotated.rds"), celltype=CELLTYPES),
        expand(os.path.join(OUTDIR, "03_subsets", "{celltype}", "05_pseudotime", "pseudotime_values.csv"), celltype=CELLTYPES),
        os.path.join(OUTDIR, "03_subsets", "_dge.done"),
        os.path.join(OUTDIR, "03_subsets", "_go.done"),
        os.path.join(OUTDIR, "02_global_annotation", f"res_{RES}", "_global_dge.done"),
        os.path.join(OUTDIR, "02_global_annotation", f"res_{RES}", "_global_go.done"),
        CELLCHAT_OUTPUTS,
        os.path.join(OUTDIR, "04_cellchat", "Global_Overview", "macro_global_cellchat.rds")

rule preprocessing:
    input:
        csv = INPUT_CSV
    output:
        rds = os.path.join(OUTDIR, "01_preprocessing", "TN.combined_dim30.rds")
    log:
        os.path.join(OUTDIR, "logs", "01_preprocessing.log")
    threads: config["preprocessing"].get("threads", 8)
    params:
        datadir = DATADIR,
        outdir = os.path.join(OUTDIR, "01_preprocessing"),
        res = RES
    shell:
        """
        eval "$(mamba shell hook --shell bash)"
        mamba activate seurat_env
        
        Rscript workflow/scripts/01_preprocessing.R \
            -f {input.csv} \
            -d {params.datadir} \
            -o {params.outdir} \
            -s all \
            -r {params.res} \
            -c {threads} &> {log}  
        """

rule global_annotation:
    input:
        rds = rules.preprocessing.output.rds
    output:
        # The R script dynamically creates a res_{resolution} folder and saves the annotated object here
        annotated_rds = os.path.join(OUTDIR, "02_global_annotation", f"res_{RES}", "TN.combined_annotated.rds")
    log:
        os.path.join(OUTDIR, "logs", "02_global_annotation.log")
    params:
        # Numbered output directory for neatness
        outdir = os.path.join(OUTDIR, "02_global_annotation"),
        res = RES,
        # Pass the preprocessing plots folder so the script can copy UMAPs for comparison
        plots_dir = os.path.join(OUTDIR, "01_preprocessing", "plots", f"res_{RES}")
    shell:
        """
        eval "$(mamba shell hook --shell bash)"
        mamba activate seurat_env
        
        Rscript workflow/scripts/02_global_annotation.R \
            -i {input.rds} \
            -s all \
            -o {params.outdir} \
            -r {params.res} \
            -p {params.plots_dir} &> {log}
        """

rule global_dge:
    input:
        annotated_rds = rules.global_annotation.output.annotated_rds,
        script = "workflow/scripts/02b_global_dge.R"
    output:
        flag = os.path.join(OUTDIR, "02_global_annotation", f"res_{RES}", "_global_dge.done")
    log:
        os.path.join(OUTDIR, "logs", "02b_global_dge.log")
    params:
        outdir = os.path.join(OUTDIR, "02_global_annotation", f"res_{RES}")
    shell:
        """
        eval "$(mamba shell hook --shell bash)"
        mamba activate seurat_env
        
        Rscript {input.script} \
            -i {input.annotated_rds} \
            -o {params.outdir} &> {log}
            
        touch {output.flag}
        """

rule global_go:
    input:
        flag = rules.global_dge.output.flag,
        script = "workflow/scripts/02c_global_go.R"
    output:
        flag = os.path.join(OUTDIR, "02_global_annotation", f"res_{RES}", "_global_go.done")
    log:
        os.path.join(OUTDIR, "logs", "02c_global_go.log")
    params:
        indir = os.path.join(OUTDIR, "02_global_annotation", f"res_{RES}", "05_dge_pseudobulk"),
        outdir = os.path.join(OUTDIR, "02_global_annotation", f"res_{RES}", "pathways")
    shell:
        """
        eval "$(mamba shell hook --shell bash)"
        mamba activate seurat_env
        
        Rscript {input.script} \
            -i {params.indir} \
            -o {params.outdir} &> {log}
            
        touch {output.flag}
        """

rule subset_clusters:
    input:
        annotated_rds = rules.global_annotation.output.annotated_rds
    output:
        subset_rds = os.path.join(OUTDIR, "03_subsets", "{celltype}", "00_data", "{celltype}_subset_processed.rds")
    log:
        os.path.join(OUTDIR, "logs", "03_subset_{celltype}.log")
    params:
        outdir = os.path.join(OUTDIR, "03_subsets")
    shell:
        """
        eval "$(mamba shell hook --shell bash)"
        mamba activate seurat_env
        
        Rscript workflow/scripts/03_subset_clusters.R \
            --input {input.annotated_rds} \
            --celltype {wildcards.celltype} \
            --outdir {params.outdir} \
            --resolution 0.2 &> {log}
        """

rule detail_annotation:
    input:
        subset_rds = rules.subset_clusters.output.subset_rds
    output:
        detailed_rds = os.path.join(OUTDIR, "03_subsets", "{celltype}", "00_data", "{celltype}_detailed_annotated.rds")
    log:
        os.path.join(OUTDIR, "logs", "04_detail_annotation_{celltype}.log")
    params:
        outdir = os.path.join(OUTDIR, "03_subsets"),
        margin = UNCERTAIN_MARGIN,
        abs_margin = UNCERTAIN_ABS_MARGIN
    shell:
        """
        eval "$(mamba shell hook --shell bash)"
        mamba activate seurat_env
        Rscript workflow/scripts/04_detail_annotation.R \
            -i {input.subset_rds} \
            -c {wildcards.celltype} \
            -o {params.outdir} \
            --uncertain_margin {params.margin} \
            --uncertain_abs_margin {params.abs_margin} &> {log}
        """

rule dge:
    # Depends on EVERY celltype's detailed annotation being done, since the
    # script processes all celltype folders under --indir in a single pass.
    input:
        detailed = expand(
            os.path.join(OUTDIR, "03_subsets", "{celltype}", "00_data", "{celltype}_detailed_annotated.rds"),
            celltype=CELLTYPES
        )
    output:
        flag = os.path.join(OUTDIR, "03_subsets", "_dge.done")
    log:
        os.path.join(OUTDIR, "logs", "05_dge.log")
    params:
        indir = os.path.join(OUTDIR, "03_subsets")
    shell:
        """
        eval "$(mamba shell hook --shell bash)"
        mamba activate seurat_env

        Rscript workflow/scripts/05_dge.R --indir {params.indir} &> {log}
        touch {output.flag}
        """

rule go:
    # Depends on dge's DESeq2 CSVs existing for every celltype.
    input:
        flag = rules.dge.output.flag
    output:
        flag = os.path.join(OUTDIR, "03_subsets", "_go.done")
    log:
        os.path.join(OUTDIR, "logs", "06_go.log")
    params:
        indir = os.path.join(OUTDIR, "03_subsets")
    shell:
        """
        eval "$(mamba shell hook --shell bash)"
        mamba activate seurat_env

        Rscript workflow/scripts/06_go.R --indir {params.indir} &> {log}
        touch {output.flag}
        """

rule pseudotime:
    input:
        detailed_rds = rules.detail_annotation.output.detailed_rds
    output:
        pseudotime_csv = os.path.join(OUTDIR, "03_subsets", "{celltype}", "05_pseudotime", "pseudotime_values.csv")
    log:
        os.path.join(OUTDIR, "logs", "07_pseudotime_{celltype}.log")
    params:
        outdir = os.path.join(OUTDIR, "03_subsets", "{celltype}", "05_pseudotime")
    shell:
        """
        eval "$(mamba shell hook --shell bash)"
        mamba activate seurat_env

        Rscript workflow/scripts/07_pseudotime.R \
            -r {input.detailed_rds} \
            --all_clusters \
            -o {params.outdir} &> {log}
        """

rule cellchat:
    input:
        # Require all possible detailed RDS files to be done first
        expand(os.path.join(OUTDIR, "03_subsets", "{celltype}", "00_data", "{celltype}_detailed_annotated.rds"), celltype=CELLTYPES)
    output:
        # Dynamically matches the exact combo string (e.g., fibroblasts_macrophages_mast_cells)
        rds = os.path.join(OUTDIR, "04_cellchat", "{network_name}", "multiway_cellchat.rds")
    log:
        os.path.join(OUTDIR, "logs", "08_cellchat_{network_name}.log")
    params:
        basedir = os.path.join(OUTDIR, "03_subsets"),
        outdir = os.path.join(OUTDIR, "04_cellchat", "{network_name}"),
        # Safely grab the comma-separated string straight from our Python dictionary
        celltypes_comma = lambda wildcards: NETWORK_MAP[wildcards.network_name]
    shell:
        """
        eval "$(mamba shell hook --shell bash)"
        mamba activate cellchat

        Rscript workflow/scripts/08_cellchat_analysis.R \
            --basedir {params.basedir} \
            --celltypes "{params.celltypes_comma}" \
            --outdir {params.outdir} &> {log}
        """

rule global_cellchat:
    input:
        # Grabs the annotated global object directly from the step 2 output
        annotated_rds = rules.global_annotation.output.annotated_rds,
        script = "workflow/scripts/08b_global_cellchat.R"
    output:
        # A specific file to trigger this rule
        rds = os.path.join(OUTDIR, "04_cellchat", "Global_Overview", "macro_global_cellchat.rds")
    log:
        os.path.join(OUTDIR, "logs", "08b_global_cellchat.log")
    params:
        outdir = os.path.join(OUTDIR, "04_cellchat", "Global_Overview")
    shell:
        """
        eval "$(mamba shell hook --shell bash)"
        mamba activate cellchat

        Rscript {input.script} \
            -i {input.annotated_rds} \
            -o {params.outdir} &> {log}
        """